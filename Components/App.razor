<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="ColorGlyphs.styles.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/dom-to-image/2.6.0/dom-to-image.min.js"></script>
    <script>
        window.descargarImagen = (idElemento) => {
        const nodo = document.getElementById(idElemento);

        const opciones = {
        bgcolor: '#fdfcf0', // Forzamos el color de fondo aquí también
        style: {
        'border-radius': '0' // Evita artefactos visuales en las esquinas
        }
        };

        domtoimage.toPng(nodo, opciones)
        .then(() => {
        return domtoimage.toPng(nodo, opciones);
        })
        .then(function (dataUrl) {
        const link = document.createElement('a');
        link.download = 'ColorGlyph_Mensaje.png';
        link.href = dataUrl;
        link.click();
        })
        .catch(function (error) {
        console.error('Error en la descarga:', error);
        });
        };
    </script>
</body>

</html>