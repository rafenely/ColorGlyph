@page "/"
@using ColorGlyphs
@using ColorGlyphs.Components
@using ColorGlyphs.Components.Shared
@using ColorGlyphs.Models
@using ColorGlyphs.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Runtime.InteropServices
@rendermode InteractiveServer
@inject TranslationService TranslationService
@inject GlyphService GlyphService
@inject IJSRuntime JS

<PageTitle>Traductor de Colores</PageTitle>

@*<input @bind="textoUsuario" @bind:event="oninput" placeholder="Escribe algo..." class="form-control" />*@
<div class="container py-5">
    <h1 class="display-5 fw-bold mb-4 text-dark">ColorGlyph <small class="text-muted fs-6 fw-normal">Traductor Artístico</small></h1>

    <div class="mb-4">
        <label class="form-label fw-semibold text-secondary">Escribe tu mensaje:</label>
        <textarea class="textarea-minimal w-100" 
                  value="@textoUsuario" 
                  @oninput="ActualizarTraduccion"
                  rows="3" 
                  placeholder="El texto se convertirá en arte..."></textarea>
    </div>
    <div class="controles-panel shadow-sm"><div class="controles-panel shadow-sm">
        <div class="row g-4 align-items-center">
            <!-- Alineación (Columna pequeña) -->
            <div class="col-auto">
                <span class="d-block small text-uppercase fw-bold text-muted mb-2">Alineación</span>
                <div class="btn-group shadow-sm">
                    <button class="btn btn-outline-primary @(alineacion=="start"?"active":"")" @onclick='()=>CambiarAlineacion("start")'><i class="bi bi-text-left"></i></button>
                    <button class="btn btn-outline-primary @(alineacion=="center"?"active":"")" @onclick='()=>CambiarAlineacion("center")'><i class="bi bi-text-center"></i></button>
                    <button class="btn btn-outline-primary @(alineacion=="end"?"active":"")" @onclick='()=>CambiarAlineacion("end")'><i class="bi bi-text-right"></i></button>
                    <button class="btn btn-outline-primary @(alineacion=="between"?"active":"")" @onclick='()=>CambiarAlineacion("between")'><i class="bi bi-justify"></i></button>
                </div>
            </div>

            <!-- Tamaño (Columna flexible) -->
            <div class="col px-4">
                <span class="d-block small text-uppercase fw-bold text-muted mb-2">Tamaño de Glifos (@glyphSize px)</span>
                <input type="range" class="form-range" min="30" max="100" @bind="glyphSize" @bind:event="oninput" />
            </div>

            <!-- Acciones (Columna de ancho fijo) -->
            <div class="col-auto">
                <button class="btn btn-dark btn-descargar shadow" @onclick="DescargarHoja">
                    <i class="bi bi-download me-2"></i> Descargar Imagen
                </button>
            </div>
            <div class="col-lg-3">
                <span class="d-block small text-uppercase fw-bold text-muted mb-2">Estilo Artístico</span>
                <select @bind="estiloSeleccionado" class="form-select shadow-sm">
                    <option value="Tinta">Tinta Tradicional</option>
                    <option value="Neon">Luz Neón</option>
                    <option value="Limpio">Limpio</option>
                </select>
            </div>
        </div>
        
        <!-- El switch debajo, más discreto -->
        <div class="form-check form-switch mt-3 pt-3 border-top">
            <input class="form-check-input" type="checkbox" id="checkMostrar" @bind="mostrarLetras" />
            <label class="form-check-label small text-muted" for="checkMostrar">Mostrar traducción debajo</label>
        </div>
    </div>
    <div id="hojaDescarga" class="hoja-libreta mt-4 d-flex flex-wrap justify-content-@alineacion">
            <GlyphFilters Theme="@estiloSeleccionado" />

        @foreach (var linea in lineasProcesadas)
        {
            <div class="d-flex flex-wrap justify-content-@alineacion" style="flex-basis: 100%;">
                @* Luego separamos por espacios para identificar cada palabra *@
                @foreach (var palabra in linea)
                {
                    <div class="grupo-palabra d-flex shadow-none">
                        @foreach (var cuadricula in palabra)
                        {
                            @if (cuadricula.Tipo == "Salto")
                            {
                                @* Esta línea fuerza a los siguientes glifos a ir a la fila de abajo *@
                                <div class="flex-break" style="flex-basis: 100%; height: @(glyphSize / 2)px;">
                                
                                </div>
                            }
                            else
                            {
                                <div class="cuadro-letra" >
                                    <Glyph GlyphModel="@cuadricula"Size="@glyphSize" />

                                    @if(mostrarLetras)
                                    {
                                        <span class="etiqueta-letra" style="font-size: @(glyphSize/6)px;">@cuadricula.Caracter</span>@**@
                                    }
                                </div>
                            }
                        }
                    </div>
                    @if (palabra != linea.Last())
                    {
                        <div class="cuadro-letra" style="width: @(glyphSize)px; height: @(glyphSize)px; visibility: hidden;"></div>
                    }
                }
            </div>
            }
            
        
    </div>
</div>
</div>
<style>
    /* El fondo de la zona donde aparecen las letras */
    .hoja-libreta {
        /* Color base de papel crema/marfil */
        background-color: #fdfcf0; 
        
        /* Textura de papel sutil usando un gradiente radial */
       background-image: 
        linear-gradient(90deg, rgba(200,0,0,0.05) 0%, rgba(200,0,0,0.05) 100%), /* Línea roja */
        linear-gradient(#e1dec2 1px, transparent 1px); /* Líneas horizontales opcionales */
        background-size: 100% 100%, 100% 40px;
        background-position: 45px 0, 0 0;
        background-repeat: no-repeat, repeat;
        
        /* Cuadrícula de guía sutil (opcional, puedes comentarla) */
        /* background-image: radial-gradient(#d1d1d1 1px, transparent 1px);
        background-size: 40px 40px; */

        padding: 60px;
        border: 1px solid #dcd9c6;
        border-radius: 4px; /* Menos redondeado para parecer papel cortado */
        
        /* Sombra de "hoja sobre mesa" */
        box-shadow: 
            0 1px 4px rgba(0,0,0,0.1), 
            0 10px 20px rgba(0,0,0,0.05);
        
        display: flex;
        flex-wrap: wrap;
        min-height: 500px;
        align-content: flex-start;
        gap: 15px; /* Más espacio entre palabras */
        
        /* Efecto de borde de papel ligeramente irregular */
        position: relative;
        overflow: hidden;
    }
    /* Efecto de "margen de libreta" (la línea roja vertical) */
    .hoja-libreta::before {
        content: "";
        position: absolute;
        left: 45px;
        top: 0;
        bottom: 0;
        width: 2px;
        background-color: rgba(255, 0, 0, 0.15);
    }
    .hoja-libreta2{
        background-color: #ffffff;
        /*background-image: radial-gradient(#d1d1d1 1.5px, transparent 1.5px);
        background-size: 30px 30px; /* Tamaño de la cuadrícula de fondo */
        padding: 50px;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.05), 0 5px 15px rgba(0,0,0,0.1);
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
        min-height: 300px;
        align-content: flex-start;
        gap: 5px;
    }
    @@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
    }
    .cuadro-letra {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 2px;
        height: auto;
        transition: all 0.2s ease;
        animation: fadeIn 0.3s ease-out forwards;
    }
    .grupo-palabra {
            display: flex;
            flex-wrap: nowrap; /* IMPORTANTE: Las letras de una palabra NO se separan */
            /*gap: 10px;         /* Espacio entre letras de la misma palabra */
    }
    /* El marco individual de cada letra */
    .marco-dibujo {
        /*background: rgba(83, 52, 52, 0);
        border: 2px solid #444;
        padding: 0px;
        border-radius: 4px;*/
        /*  box-shadow: 3px 3px 0px #888; /* Efecto de relieve */
        flex-shrink: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .rejilla-puntos {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
        align-content: space-around;
        height: 100%;
        width: 100%;
        padding: 2px;
    }

    .punto {
        width: 35%;
        height: 35%;
        margin: 2%;
        @*border-radius: 50%;
        border: 50% solid rgba(0, 0, 0, 0);*@
        filter: url(#ink-effect); 

        /* Toque final: Ligeramente translúcido para que se vea el papel detrás */
        opacity: 0.9;
        
        /* Pequeño desenfoque muy sutil para simular absorción */
        /*box-shadow: 0 0 2px rgba(0,0,0,0.2) inset;*/
    }
    .etiqueta-letra {
        display: block;
        text-align: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: bold;
        color: #666;
        margin-top: 10px;
        font-size: 0.9rem;
        white-space: nowrap;
        text-transform: uppercase;
    }
    .espacio-blanco {
    display: inline-block;
    flex-shrink: 0; /* Evita que el espacio se comprima si hay poco sitio */
    }

    .controles-panel {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    /* Chuleando el slider (Range) */
    .form-range::-webkit-slider-thumb {
        background: #0d6efd;
    }

    /* Chuleando los botones */
    .btn-group .btn {
        padding: 10px 15px;
        border-width: 2px;
    }

    .btn-lg {
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

    .btn-lg:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(25, 135, 84, 0.3);
    }
    textarea-minimal {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 1rem;
    font-size: 1.1rem;
    transition: border-color 0.2s;
    background: #fff;
}

.textarea-minimal:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
    outline: none;
}
</style>

@code {
    private string textoUsuario = "";
    private List<GlyphModel> glifosRenderizados = new(); // Nueva variable para los glifos
    private bool mostrarLetras = false;
    private string alineacion = "start";
    private int glyphSize = 60;
    private List<List<List<GlyphModel>>> lineasProcesadas = new();

    private string estiloSeleccionado = "Limpio";

    private async Task ActualizarTraduccion(ChangeEventArgs e)
    {
        textoUsuario = e.Value?.ToString() ?? "";
        await GenerarEstructuraTraduccion();
    }
    private async Task GenerarEstructuraTraduccion()
    {
        if (string.IsNullOrWhiteSpace(textoUsuario))
        {
            lineasProcesadas.Clear();
            return;
        }

        var nuevasLineas = new List<List<List<GlyphModel>>>();
        var lineasRaw = textoUsuario.Split('\n');

        foreach (var linea in lineasRaw)
        {
            var palabrasEnLinea = new List<List<GlyphModel>>();
            var palabrasRaw = linea.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            foreach (var palabra in palabrasRaw)
            {
                // Aquí usamos AWAIT de forma segura
                var glifosDePalabra = await TranslationService.TraducirTexto(palabra);
                palabrasEnLinea.Add(glifosDePalabra);
            }
            nuevasLineas.Add(palabrasEnLinea);
        }
        lineasProcesadas = nuevasLineas;
    }   
    private void CambiarAlineacion(string nuevaAlineacion)
    {
        alineacion = nuevaAlineacion;
    }
    private async Task DescargarHoja()
    {
        if (JS is not null)
        {
            await JS.InvokeVoidAsync("descargarImagen", "hojaDescarga");
        }
    }
}