@page "/"
@using ColorGlyphs
@using ColorGlyphs.Components
@using ColorGlyphs.Components.Shared
@using ColorGlyphs.Models
@using ColorGlyphs.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Runtime.InteropServices
@rendermode InteractiveServer
@inject TranslationService TranslationService
@inject ConfigService ConfigService
@inject GlyphService GlyphService
@inject IJSRuntime JS

<PageTitle>Traductor de Colores</PageTitle>

<div class="container py-5">
    <h1 class="display-5 fw-bold mb-4 text-dark" style="text-align: center;">ColorGlyph <small class="text-muted fs-6 fw-normal">Traductor Artístico</small></h1>

    <div class="sticky-top bg-white pt-2 pb-3 shadow-sm rounded px-3 border mb-4" style="top: 10px; z-index: 1020;">
        
        <div class="row g-2 align-items-center mb-3">
            <div class="col-md-6 col-lg-7">
                <label class="form-label fw-bold small text-muted mb-1">Escribe tu mensaje:</label>
                <div class="input-group">
                    <textarea class="textarea-minimal w-100 form-control" 
                              value="@textoUsuario" 
                              @oninput="ActualizarTraduccion"
                              rows="2" 
                              placeholder="El texto se convertirá en arte..."></textarea>
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <label class="form-label fw-bold small text-muted mb-1">Modo de Dibujo (Alfabeto)</label>
                <select class="form-select" @bind="modoActivoId" @bind:after="OnModoCambiado">
                    @foreach (var modo in listaModos)
                    {
                        <option value="@modo.Id">@modo.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-2 col-lg-2 text-center border-start d-none d-md-block">
                <label class="form-label fw-bold small text-success mb-1">Último Glifo</label>
                <div class="d-flex justify-content-center align-items-center" style="height: 38px;">
                    @if (lineasProcesadas.Any() && lineasProcesadas.Last().Any() && lineasProcesadas.Last().Last().Any())
                    {
                        <Glyph GlyphModel="@lastGlyph" Size="32" />
                    }
                    else
                    {
                        <span class="text-muted small">-</span>
                    }
                </div>
            </div>
        </div>
        
        <div class="row g-3 align-items-center pt-2 border-top">
            <div class="col-auto">
                <div class="btn-group btn-group-sm shadow-sm">
                    <button class="btn btn-outline-primary @(alineacion=="start"?"active":"")" @onclick='()=>CambiarAlineacion("start")'><i class="bi bi-text-left"></i></button>
                    <button class="btn btn-outline-primary @(alineacion=="center"?"active":"")" @onclick='()=>CambiarAlineacion("center")'><i class="bi bi-text-center"></i></button>
                    <button class="btn btn-outline-primary @(alineacion=="end"?"active":"")" @onclick='()=>CambiarAlineacion("end")'><i class="bi bi-text-right"></i></button>
                    <button class="btn btn-outline-primary @(alineacion=="between"?"active":"")" @onclick='()=>CambiarAlineacion("between")'><i class="bi bi-justify"></i></button>
                </div>
            </div>

            <div class="col px-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted fw-bold text-nowrap">Size: @glyphSize px</span>
                    <input type="range" class="form-range" min="30" max="100" @bind="glyphSize" @bind:event="oninput" />
                </div>
            </div>

            <div class="col-auto">
                <select @bind="estiloSeleccionado" class="form-select form-select-sm shadow-sm">
                    <option value="Tinta">Tinta Tradicional</option>
                    <option value="Neon">Luz Neón</option>
                    <option value="Limpio">Limpio</option>
                </select>
            </div>

            <div class="col-auto">
                <button class="btn btn-sm btn-dark shadow-sm" @onclick="DescargarHoja">
                    <i class="bi bi-download me-1"></i> Imagen
                </button>
            </div>

            <div class="col-auto border-start ps-3">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="checkMostrar" @bind="mostrarLetras" />
                    <label class="form-check-label small text-muted fw-bold" for="checkMostrar">Letras</label>
                </div>
            </div>
        </div>

    </div>

    <div id="hojaDescarga" class="hoja-libreta mt-4 d-flex flex-wrap justify-content-@alineacion">
        <GlyphFilters Theme="@estiloSeleccionado" />

        @foreach (var linea in lineasProcesadas)
        {
            <div class="d-flex flex-wrap justify-content-@alineacion" style="flex-basis: 100%;">
                @foreach (var palabra in linea)
                {
                    <div class="grupo-palabra d-flex shadow-none">
                        @foreach (var cuadricula in palabra)
                        {
                            @if (cuadricula.Tipo == "Salto")
                            {
                                <div class="flex-break" style="flex-basis: 100%; height: @(glyphSize / 2)px;"></div>
                            }
                            else
                            {
                                <div class="cuadro-letra">
                                    <Glyph GlyphModel="@cuadricula" Size="@glyphSize" />

                                    @if(mostrarLetras)
                                    {
                                        <span class="etiqueta-letra" style="font-size: @(glyphSize/6)px;">@cuadricula.Caracter</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                    @if (palabra != linea.Last())
                    {
                        <div class="cuadro-letra" style="width: @(glyphSize)px; height: @(glyphSize)px; visibility: hidden;"></div>
                    }
                }
            </div>
        }
    </div>
</div>

<style>
    .hoja-libreta {
        background-color: #fdfcf0; 
        background-image: 
            linear-gradient(90deg, rgba(200,0,0,0.05) 0%, rgba(200,0,0,0.05) 100%), 
            linear-gradient(#e1dec2 1px, transparent 1px); 
        background-size: 100% 100%, 100% 40px;
        background-position: 45px 0, 0 0;
        background-repeat: no-repeat, repeat;
        padding: 60px;
        border: 1px solid #dcd9c6;
        border-radius: 4px; 
        box-shadow: 0 1px 4px rgba(0,0,0,0.1), 0 10px 20px rgba(0,0,0,0.05);
        display: flex;
        flex-wrap: wrap;
        min-height: 500px;
        align-content: flex-start;
        gap: 15px; 
        position: relative;
        overflow: hidden;
    }
    .hoja-libreta::before {
        content: "";
        position: absolute;
        left: 45px;
        top: 0;
        bottom: 0;
        width: 2px;
        background-color: rgba(255, 0, 0, 0.15);
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .cuadro-letra {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 2px;
        height: auto;
        transition: all 0.2s ease;
        animation: fadeIn 0.3s ease-out forwards;
    }
    .grupo-palabra {
        display: flex;
        flex-wrap: nowrap; 
    }
    .punto {
        width: 35%;
        height: 35%;
        margin: 2%;
        filter: url(#ink-effect); 
        opacity: 0.9;
    }
    .etiqueta-letra {
        display: block;
        text-align: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: bold;
        color: #666;
        margin-top: 10px;
        font-size: 0.9rem;
        white-space: nowrap;
        text-transform: uppercase;
    }
    .btn-group .btn {
        padding: 6px 12px;
    }
    .textarea-minimal {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.5rem;
        font-size: 1.1rem;
        transition: border-color 0.2s;
        background: #fff;
    }
    .textarea-minimal:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
        outline: none;
    }
</style>

@code {
    private string textoUsuario = "";
    private List<GlyphModel> glifosRenderizados = new();
    private bool mostrarLetras = false;
    private string alineacion = "start";
    private int glyphSize = 60;
    private List<List<List<GlyphModel>>> lineasProcesadas = new();

    private string estiloSeleccionado = "Limpio";
    private List<DrawingMode> listaModos = new();
    private int modoActivoId = 1;
    private GlyphModel? lastGlyph;

    protected override async Task OnInitializedAsync()
    {
        listaModos = await ConfigService.ObtenerModosDeDibujo();
    }
    private async Task ActualizarTraduccion(ChangeEventArgs e)
    {
        textoUsuario = e.Value?.ToString() ?? "";
        await GenerarEstructuraTraduccion();
    }
    private async Task GenerarEstructuraTraduccion()
    {
        if (string.IsNullOrWhiteSpace(textoUsuario))
        {
            lineasProcesadas.Clear();
            return;
        }

        var nuevasLineas = new List<List<List<GlyphModel>>>();
        var lineasRaw = textoUsuario.Split('\n');

        foreach (var linea in lineasRaw)
        {
            var palabrasEnLinea = new List<List<GlyphModel>>();
            var palabrasRaw = linea.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            foreach (var palabra in palabrasRaw)
            {
                var glifosDePalabra = await TranslationService.TraducirTexto(palabra,modoActivoId);
                palabrasEnLinea.Add(glifosDePalabra);
            }
            nuevasLineas.Add(palabrasEnLinea);
        }
        lineasProcesadas = nuevasLineas;
        
        if(lineasProcesadas.Any() && lineasProcesadas.Last().Any() && lineasProcesadas.Last().Last().Any())
            lastGlyph = lineasProcesadas.Last().Last().Last();
    }   
    private void CambiarAlineacion(string nuevaAlineacion)
    {
        alineacion = nuevaAlineacion;
    }
    private async Task DescargarHoja()
    {
        if (JS is not null)
        {
            await JS.InvokeVoidAsync("descargarImagen", "hojaDescarga");
        }
    }
    private async Task OnModoCambiado()
    {
        await GenerarEstructuraTraduccion();
        StateHasChanged();
    }
}