@page "/admin"
@using ColorGlyphs
@using ColorGlyphs.Models
@using ColorGlyphs.Components
@using ColorGlyphs.Components.Shared
@using ColorGlyphs.Services
@using System.Runtime.InteropServices
@using System.Threading.Tasks

@inject GlyphService GlyphService
@inject ConfigService ConfigService
@inject IJSRuntime JSRuntime

@rendermode InteractiveServer
<h3 class="mb-4">Administración de Glyphos</h3>
<div class="card p-3 mb-4 border-info shadow-sm bg-light">
    <div class="d-flex justify-content-between align-items-center "
         @onclick="() => mostrarGestorModos = !mostrarGestorModos">
        <h6 class="mb-0 text-info fw-bold">
            <i class="bi bi-gear-fill me-2"></i> Gestión de Alfabetos (Modos de Dibujo)
        </h6>
        <i class="bi @(mostrarGestorModos ? "bi-chevron-up" : "bi-chevron-down")"></i>
    </div>

    @if (mostrarGestorModos)
    {
        <div class="row g-3 mt-2 pt-3 border-top">
            <div class="col-md-5">
                <label class="form-label fw-bold small text-muted">Crear Nuevo Alfabeto</label>
                <div class="input-group">
                    <input type="text" class="form-control" @bind="nuevoModoNombre"
                           placeholder="Ej: Rúnico, Enano, Celestial..." />
                    <button class="btn btn-info text-white" @onclick="CrearModo">
                        <i class="bi bi-plus-circle-fill me-1"></i> Crear
                    </button>
                </div>
            </div>

            <div class="col-md-7 border-start">
                <label class="form-label fw-bold small text-muted">Alfabetos Registrados</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var modo in listaModos)
                    {
                        <span class="badge bg-secondary p-2 d-flex align-items-center fs-6">
                            @modo.Nombre
                            @* No permitimos borrar el ID 1 (Clásico) para no quedarnos sin ningún modo *@
                            @if (modo.Id != 1)
                            {
                                <i class="bi bi-trash-fill ms-2 text-danger cursor-pointer"
                                   @onclick="() => EliminarModo(modo.Id, modo.Nombre)"
                                   title="Eliminar este alfabeto y todos sus glifos"></i>
                            }
                        </span>
                    }
                </div>
            </div>
        </div>
    }
</div>
<div class="card p-4 mb-5 shadow-sm">
    <h5>@(editandoId == 0 ? "Agregar Nuevo Glifo" : "Modificando Glifo")</h5>
    <div class="row g-3">
        <div class="col-md-2">
            <label class="form-label">preGlyph</label>
            <Glyph GlyphModel="@nuevoGlyph" Size="60" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Carácter/Símbolo</label>
            <input type="text" class="form-control" @bind="nuevoGlyph.Caracter" maxlength="1" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Modo de Dibujo (Alfabeto)</label>
            <select class="form-select" @bind="modoActivoId" @bind:after="OnModoCambiado">
                @foreach (var modo in listaModos)
                {
                    <option value="@modo.Id">@modo.Nombre</option>
                }
            </select>
        </div>
        <div type="hidden" class="col-md-3">
            <!--<label class="form-label text-muted small">Formas (ej: circulo,triangulo)</label>-->
            <input type="hidden" class="form-control" @bind="formasTexto" readonly />
        </div>
        <div type="hidden" class="col-md-3">
            <!--<label class="form-label text-muted small">Colores (separados por coma)</label>-->
            <input type="hidden" class="form-control" @bind="nuevoGlyph.Colores" readonly />
        </div>
        <div class="row g-3 p-3 border rounded bg-light">
            <div class="col-md-6">
                <label class="form-label fw-bold text-primary">Colores seleccionados (en orden):</label>
                <div class="d-flex flex-wrap gap-2 mb-2 p-2 border rounded bg-white min-height-50">
                    @foreach (var c in coloresSeleccionados)
                    {
                        <span class="badge rounded-pill d-flex align-items-center"
                              style="background-color: @c.Code; color: rgb(255, 255, 255); padding: 8px 12px;">
                            @c.Description
                            @if (c.Description == "")
                            {
                                <i class="bi bi-x-circle-fill ms-2 cursor-pointer bg-black text-white rounded-circle"
                                   @onclick="() => RemoverColor(c)"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill ms-2 cursor-pointer" @onclick="() => RemoverColor(c)"></i>
                            }
                        </span>
                    }
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var c in listaColoresDisponibles)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => AgregarColor(c)">
                            + @c.Description
                        </button>
                    }
                </div>
            </div>

            <div class="col-md-6 border-start">
                <label class="form-label fw-bold text-success">Formas seleccionadas (en orden):</label>
                <div class="d-flex flex-wrap gap-2 mb-2 p-2 border rounded bg-white min-height-50">
                    @foreach (var f in formasSeleccionadas)
                    {
                        <span class="badge bg-success d-flex align-items-center" style="padding: 8px 12px;">
                            @f.Description
                            <i class="bi bi-x-circle-fill ms-2 cursor-pointer" @onclick="() => RemoverForma(f)"></i>
                        </span>
                    }
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var f in listaFormasDisponibles)
                    {
                        <button class="btn btn-sm btn-outline-success" @onclick="() => AgregarForma(f)">
                            + @f.Description
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="Guardar">
                    @(editandoId == 0 ? "Añadir" : "Actualizar")
                </button>
            </div>
        </div>
        <div class="card p-3 mb-4 bg-light border-warning">
            <h6><span class="bi bi-exclamation-triangle-fill"></span> Acción Masiva: Cambiar todas las formas</h6>
            <div class="d-flex gap-2 align-items-center">
                <select class="form-select w-auto" @bind="formaMasivaSeleccionada">
                    <option value="">-- Selecciona una forma --</option>
                    @foreach (var f in todasLasFormas)
                    {
                        <option value="@f.Description">@f.Description</option>
                    }
                </select>
                <button class="btn btn-warning" @onclick="AplicarCambioMasivo">
                    Aplicar a todos los Glifos
                </button>
            </div>
        </div>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Glypho</th>
            <th>Carácter</th>
            <th>Formas</th>
            <th>Colores</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in todosLosGlyphs.OrderBy(x => x.Caracter))
        {
            <tr>
                <td>
                    <Glyph GlyphModel="@g" />
                </td>
                <td><strong>@g.Caracter</strong></td>
                <td>
                    @foreach (var gf in g.GlyphForms)
                    {
                        <span class="badge bg-secondary me-1">@gf.Form.Description</span>
                    }
                </td>
                <td><small>@g.Colores</small></td>
                <td>
                    <button class="btn btn-sm btn-outline-secondary me-2"
                            @onclick="() => CargarParaEditar(g)">Editar</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Borrar(g.Id)">Borrar</button>
                </td>
            </tr>
        }
    </tbody>
</table>
<style>
    .cursor-pointer {
        cursor: pointer;
        transition: transform 0.2s;
    }

    .cursor-pointer:hover {
        transform: scale(1.2);
    }
</style>
@code {
    private List<GlyphModel> todosLosGlyphs = new();
    private GlyphModel nuevoGlyph = new();
    private string formasTexto = ""; // Para manejar el input de texto
    private int editandoId = 0;

    private string formaMasivaSeleccionada = "";
    private List<FormModel> todasLasFormas = new();
    private List<DrawingMode> listaModos = new();
    private int modoActivoId = 1;
    
    protected override async Task OnInitializedAsync()
    {
        listaModos = await ConfigService.ObtenerModosDeDibujo();
        await CargarLista();
        todasLasFormas = await ConfigService.ObtenerFormas();
        listaFormasDisponibles = todasLasFormas; // Ya las tienes cargadas
        listaColoresDisponibles = await ConfigService.ObtenerColores();

        listaColoresDisponibles.Add(new GlyphColorModel() { Code = "#00000000", Description = "" });
        
    }

    private async Task CargarLista()
    {
        var todos = await GlyphService.ObtenerTodos();
        todosLosGlyphs = todos.Where(g => g.DrawingModeId == modoActivoId).ToList();
    }

    private async Task OnModoCambiado()
    {
        await CargarLista();
        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (string.IsNullOrEmpty(nuevoGlyph.Caracter)) return;

        nuevoGlyph.DrawingModeId = modoActivoId;
        nuevoGlyph.Tipo = nuevoGlyph.GetGlyphType();
        nuevoGlyph.GlyphForms = await ConfigService.ConvertirTextoAFormas(formasTexto);
        
        if (editandoId == 0) await GlyphService.Crear(nuevoGlyph);
        else await GlyphService.Modificar(nuevoGlyph);

        nuevoGlyph = new();
        formasTexto = "";
        coloresSeleccionados.Clear();
        formasSeleccionadas.Clear();
        editandoId = 0;
        await CargarLista();
        StateHasChanged();
    }

    private void CargarParaEditar(GlyphModel g)
    {
        editandoId = g.Id;
        nuevoGlyph = new GlyphModel
        {
            Id = g.Id,
            Caracter = g.Caracter,
            Tipo = g.Tipo,
            GlyphForms = g.GlyphForms,
            Colores = g.Colores
        };
        if (g.GlyphForms != null && g.GlyphForms.Any())
        {
            formasTexto = string.Join(",", g.GlyphForms
                .Select(gf => gf.Form?.Description)
                .Where(d => d != null));
        }
        else
        {
            formasTexto = "";
        }
        // 1. Sincronizar Formas
        formasSeleccionadas = nuevoGlyph.GlyphForms
                            .Where(gf => gf.Form != null)
                            .Select(gf => gf.Form!)
                            .ToList();
        formasTexto = string.Join(",", formasSeleccionadas.Select(f => f.Description));

        // 2. Sincronizar Colores
        var nombresColores = g.Colores.Split(',', StringSplitOptions.RemoveEmptyEntries);
        coloresSeleccionados.Clear();
        foreach (var nombre in nombresColores)
        {
            var colorEncontrado = listaColoresDisponibles.FirstOrDefault(c => c.Description.Equals(nombre.Trim(),
            StringComparison.OrdinalIgnoreCase));
            if (colorEncontrado != null)
            {
                coloresSeleccionados.Add(colorEncontrado);
            }
        }
    }

    private async Task Borrar(int id)
    {
        await GlyphService.Eliminar(id);
        await CargarLista();
    }

    private async Task AplicarCambioMasivo()
    {
        if (string.IsNullOrEmpty(formaMasivaSeleccionada)) return;

        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
            new object[] { $"¡No mames Gabriela! ¿Segura que quieres cambiar TODOS los glifos a {formaMasivaSeleccionada}?" });

        if (confirmar)
        {
            await ConfigService.CambiarTodasLasFormas(formaMasivaSeleccionada, modoActivoId);
            await CargarLista();
            StateHasChanged();
        }
    }

    private List<GlyphColorModel> coloresSeleccionados = new();
    private List<FormModel> formasSeleccionadas = new();

    // Estos vendrían de tus servicios
    private List<GlyphColorModel> listaColoresDisponibles = new();
    private List<FormModel> listaFormasDisponibles = new();

    private async Task AgregarColor(GlyphColorModel color)
    {
        if (coloresSeleccionados.Count < 4)
        {
            coloresSeleccionados.Add(color);
            await ActualizarStringColores();
        }
    }

    private async Task RemoverColor(GlyphColorModel color)
    {
        coloresSeleccionados.Remove(color);
        await ActualizarStringColores();
    }

    private async Task ActualizarStringColores()
    {
        // Esto mantiene sincronizado tu objeto con el string de la DB
        nuevoGlyph.Colores = string.Join(",", coloresSeleccionados.Select(c => c.Description));
        await ActualizarPreviewGlyph();
    }

    private async Task AgregarForma(FormModel form)
    {
        if (formasSeleccionadas.Count < 4)
        {
            formasSeleccionadas.Add(form);
            await ActualizarStringFormas();
        }
    }

    private async Task RemoverForma(FormModel form)
    {
        formasSeleccionadas.Remove(form);
        await ActualizarStringFormas();
    }

    private async Task ActualizarStringFormas()
    {
        // Esto mantiene sincronizado tu objeto con el string de la DB
        formasTexto = string.Join(",", formasSeleccionadas.Select(c => c.Description));
        await ActualizarPreviewGlyph();
    }

    private async Task ActualizarPreviewGlyph()
    {
        nuevoGlyph.GlyphForms = await ConfigService.ConvertirTextoAFormas(formasTexto);
        StateHasChanged();
    }

    private bool mostrarGestorModos = false;
    private string nuevoModoNombre = "";

    // Método para crear un nuevo alfabeto
    private async Task CrearModo()
    {
        if (string.IsNullOrWhiteSpace(nuevoModoNombre)) return;

        var nuevoModo = new DrawingMode
        {
            Nombre = nuevoModoNombre.Trim()
        };

        // Guardamos en la BD usando tu ConfigService
        await ConfigService.CrearModoDeDibujo(nuevoModo); // Asegúrate de tener este método en el servicio
        
        nuevoModoNombre = ""; // Limpiamos el input
        
        // Recargamos los modos para que aparezcan en los selects
        listaModos = await ConfigService.ObtenerModosDeDibujo();
        StateHasChanged();
    }

    // Método para eliminar un alfabeto viejo
    private async Task EliminarModo(int id, string nombre)
    {
        // Alerta de seguridad (Cascada: eliminar el modo borrará todos sus glifos asociados)
        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
            new object[] { $"¿Segura Gabriela? Si eliminas el alfabeto '{nombre}', se borrarán permanentemente TODOS los glifos que creaste dentro de él." });

        if (confirmar)
        {
            await ConfigService.EliminarModoDeDibujo(id); // Asegúrate de tener este método en el servicio
            
            // Si el modo que eliminamos era el que estábamos visualizando, regresamos al Clásico (ID 1)
            if (modoActivoId == id)
            {
                modoActivoId = 1;
            }

            // Recargamos todo
            listaModos = await ConfigService.ObtenerModosDeDibujo();
            await CargarLista();
            StateHasChanged();
        }
    }
}